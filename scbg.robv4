local dragging = false
local dragStart
local startPos

Top.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        startPos = Main.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then

        local delta = input.Position - dragStart

        local newPos = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )

        Main.Position = newPos
        Shadow.Position = newPos + UDim2.fromOffset(0, 8)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = false
    end
end)

local function buttonSize(button, size)
    TweenService:Create(
        button,
        TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        {
            Size = size
        }
    ):Play()
end

ExecuteButton.MouseEnter:Connect(function()
    buttonSize(ExecuteButton, UDim2.fromOffset(184, 49))
end)

ExecuteButton.MouseLeave:Connect(function()
    buttonSize(ExecuteButton, UDim2.fromOffset(181, 47))
end)

CopyButton.MouseEnter:Connect(function()
    buttonSize(CopyButton, UDim2.fromOffset(184, 49))
end)

CopyButton.MouseLeave:Connect(function()
    buttonSize(CopyButton, UDim2.fromOffset(181, 47))
end)

local function notify(text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "ROBV4",
            Text = text,
            Duration = 3
        })
    end)
end

ExecuteButton.MouseButton1Click:Connect(function()
    Status.Text = "正在执行 ROBV4..."
    Status.TextColor3 = Color3.fromRGB(40, 110, 70)

    local fn = loadstring(V4Code)

    if not fn then
        Status.Text = "ROBV4 加载失败"
        Status.TextColor3 = Color3.fromRGB(180, 55, 55)
        notify("ROBV4 加载失败")
        return
    end

    local ok = pcall(fn)

    if ok then
        Status.Text = "ROBV4 已执行"
        Status.TextColor3 = Color3.fromRGB(40, 110, 70)
        notify("ROBV4 执行成功")

        task.wait(0.15)

        local gui = CoreGui:FindFirstChild("ROBV4Announcement")
        if gui then
            gui:Destroy()
        end
    else
        Status.Text = "ROBV4 执行失败"
        Status.TextColor3 = Color3.fromRGB(180, 55, 55)
        notify("ROBV4 执行失败")
    end
end)

CopyButton.MouseButton1Click:Connect(function()
    local copied = pcall(function()
        if setclipboard then
            setclipboard(V4Code)
        elseif toclipboard then
            toclipboard(V4Code)
        elseif writeclipboard then
            writeclipboard(V4Code)
        else
            error("clipboard unavailable")
        end
    end)

    if copied then
        Status.Text = "ROBV4 代码已复制"
        Status.TextColor3 = Color3.fromRGB(55, 105, 180)
        CopyButton.Text = "已复制 ROBV4 代码"

        notify("ROBV4 代码已复制")

        task.delay(1.5, function()
            if CopyButton.Parent then
                CopyButton.Text = "复制 ROBV4 代码"
            end
        end)
    else
        Status.Text = "当前环境不支持复制"
        Status.TextColor3 = Color3.fromRGB(180, 120, 55)
        notify("当前环境不支持剪贴板")
    end
end)

Main.BackgroundTransparency = 1
