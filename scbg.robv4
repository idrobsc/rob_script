Shadow.BackgroundTransparency = 1

TweenService:Create(
    Main,
    TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
    {
        BackgroundTransparency = 0.12,
        Size = UDim2.fromOffset(430, 250)
    }
):Play()

TweenService:Create(
    Shadow,
    TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
    {
        BackgroundTransparency = 0.72,
        Size = UDim2.fromOffset(430, 250)
    }
):Play()
